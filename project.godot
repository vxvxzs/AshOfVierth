; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="AshOfVierth"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.4", "Mobile")
config/icon="res://icon.svg"

[autoload]

ProgressionManager="*res://scripts/systems/progression_manager.gd"
WorldState="*res://scripts/autoload/world_state.gd"
DialogueManager="*res://scripts/autoload/dialogue_manager.gd"
SaveManager="*res://scripts/autoload/save_manager.gd"
SceneDirector="*res://scripts/autoload/scene_director.gd"
AudioManager="*res://scripts/autoload/audio_manager.gd"
DayNightCycle="*res://scripts/autoload/day_night_cycle.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[rendering]

renderer/rendering_method="mobile"
textures/default_filters/use_nearest_mipmap_filter=true
2d/snap/snap_2d_transforms_to_pixel=true
